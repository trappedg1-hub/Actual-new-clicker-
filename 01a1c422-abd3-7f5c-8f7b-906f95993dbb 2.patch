+
+  assert.deepEqual(source.frameNames.sort(), ["one", "two"]);
+  const one = source.texture("one");
+  assert.ok(one);
+  assert.equal(one.frame.width, 10);
+  assert.equal(one.frame.x, 0);
+  const two = source.texture("two");
+  assert.ok(two);
+  assert.equal(two.frame.x, 10);
+});
