{
  "name": "anime-fanservice-clicker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "npm run compile:ink && vite --host 0.0.0.0",
    "build": "npm test && npm run lint && npm run typecheck && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run compile:ink && npm run test:unit",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "compile:ink": "inkjs-compiler -o src/content/dialogues/intro.json src/content/dialogues/intro.ink"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@pixi/layout": "3.2.1",
    "@pixi/ui": "2.4.1",
    "inkjs": "2.4.0",
    "pixi.js": "8.22.0",
    "pixijs-actions": "1.5.0",
    "yoga-layout": "3.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "prettier": "^3.5.3",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^6.2.0"
  }
}
